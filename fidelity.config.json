{
  "mockup": {
    "file": "../LBP_V9.9_Studio.html"
  },
  "app": {
    "baseUrl": "http://localhost:3100",
    "storageState": ".fidelity/auth.json"
  },
  "outDir": ".fidelity",
  "locale": "fr-FR",
  "timezone": "Europe/Paris",
  "fonts": ["Archivo"],
  "freeze": {
    "date": "2026-10-06T08:20:00+02:00",
    "disableAnimations": true,
    "clearStorage": true
  },
  "thresholds": {
    "pixel": 0.1,
    "pageMaxDiffRatio": 0.005,
    "componentMaxDiffRatio": 0.001,
    "pxTolerance": 0.5
  },
  "viewports": [
    {
      "name": "desktop",
      "width": 1240,
      "height": 900
    }
  ],
  "hide": [".chat-fab", "nextjs-portal"],
  "ignoreProps": ["cursor"],
  "pages": [
    {
      "id": "client-accueil",
      "mockup": {
        "setup": [
          {
            "eval": "goView('overview')"
          },
          {
            "waitFor": "#v-overview.active"
          }
        ]
      },
      "app": {
        "path": "/accueil"
      },
      "components": [
        {
          "id": "header",
          "mockup": "header.top"
        },
        {
          "id": "nav-item-active",
          "mockup": ".topnav button.on"
        },
        {
          "id": "nav-item",
          "mockup": ".topnav button:not(.on)"
        }
      ]
    },
    {
      "id": "client-entreprise",
      "mockup": {
        "setup": [
          {
            "eval": "goView('documents')"
          },
          {
            "waitFor": "#v-documents.active"
          }
        ]
      },
