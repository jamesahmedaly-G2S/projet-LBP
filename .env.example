# Copier vers .env.local (jamais commite) et renseigner les vraies valeurs.
# En developpement local, ce sont les valeurs affichees par `npm run supabase:start`.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# STU-VEILLE-04 : reserve aux Route Handlers sans session utilisateur
# (cron). Jamais NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Secret attendu par POST /api/cron/veille (header x-cron-secret).
VEILLE_CRON_SECRET=

# Optionnels — connecteurs AUTOMATION-02/03 (#86, #87) restent en etat
# "non configure" tant que ces cles sont absentes, jamais simules.
LEGIFRANCE_CLIENT_ID=
LEGIFRANCE_CLIENT_SECRET=
ANTHROPIC_API_KEY=
