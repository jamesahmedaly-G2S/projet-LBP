# Copier vers .env.local (jamais commite) et renseigner les vraies valeurs.
# En developpement local, ce sont les valeurs affichees par `npm run supabase:start`.

NEXT_PUBLIC_SUPABASE_URL=http://127.0.0.1:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# STU-VEILLE-04 : reserve aux Route Handlers sans session utilisateur
# (cron). Jamais NEXT_PUBLIC_.
SUPABASE_SERVICE_ROLE_KEY=

# Secret attendu par POST /api/cron/veille (header x-cron-secret).
VEILLE_CRON_SECRET=

# Optionnels — connecteurs AUTOMATION-02/03 (#86, #87) restent en etat
# "non configure" tant que ces cles sont absentes, jamais simules.
LEGIFRANCE_CLIENT_ID=
LEGIFRANCE_CLIENT_SECRET=
# "sandbox" pour tester sur sandbox-api.piste.gouv.fr avant la prod, sinon
# "production" (defaut) - cf. Annexe A §10.2 du cahier des charges.
LEGIFRANCE_ENV=
ANTHROPIC_API_KEY=

# Optionnel — notification e-mail/SMS a la detection (Brevo), CR 10/09 :
# etape explicite du circuit de veille attendu par Pauline. "Non configuree"
# tant que BREVO_API_KEY est absente, jamais simulee.
BREVO_API_KEY=
MAIL_FROM=veille@groupe-2s.com
MAIL_FROM_NAME=LBP — Veille reglementaire
MAIL_TO=pauline.letourneur@groupe-2s.com
SMS_TO=
SMS_SENDER=G2S
